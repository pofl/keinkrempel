---
import { business, designs } from "../data/business";

interface Props {
  title: string;
  fonts: string;
  current?: string;
}

const { title, fonts, current } = Astro.props;
---

<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={`${business.tagline}. Mit bis zu ${business.warrantyMonths} Monaten Garantie.`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={`https://fonts.googleapis.com/css2?${fonts}&display=swap`} />
  </head>
  <body>
    <slot />
    {
      current && (
        <nav class="switcher" aria-label="Entwürfe">
          <a href="/">Übersicht</a>
          {designs.map((d, i) => (
            <a href={`/entwurf/${d.slug}`} aria-current={d.slug === current ? "page" : undefined}>
              {i + 1}
            </a>
          ))}
        </nav>
      )
    }
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  html {
    -webkit-text-size-adjust: 100%;
    scroll-behavior: smooth;
  }
  body {
    margin: 0;
    -webkit-font-smoothing: antialiased;
  }
  img,
  svg {
    display: block;
    max-width: 100%;
  }
  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation: none !important;
      transition: none !important;
      scroll-behavior: auto !important;
    }
  }
</style>

<style>
  .switcher {
    position: fixed;
    bottom: 1rem;
    left: 50%;
    translate: -50% 0;
    z-index: 1000;
    display: flex;
    gap: 0.25rem;
    padding: 0.3rem;
    border-radius: 999px;
    background: rgb(20 20 20 / 0.85);
    backdrop-filter: blur(8px);
    font: 500 0.8rem/1 ui-monospace, monospace;
    box-shadow: 0 6px 24px rgb(0 0 0 / 0.25);
  }
  .switcher a {
    color: #ddd;
    text-decoration: none;
    padding: 0.5rem 0.75rem;
    border-radius: 999px;
  }
  .switcher a:hover {
    background: rgb(255 255 255 / 0.12);
  }
  .switcher a[aria-current="page"] {
    background: #fff;
    color: #111;
  }
</style>
