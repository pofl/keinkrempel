---
import Mascot from "../../components/Mascot.astro";
import Wordmark from "../../components/Wordmark.astro";
import { business as b } from "../../data/business";
import Base from "../../layouts/Base.astro";

const photo = `${import.meta.env.BASE_URL}images/laden.jpg`;
const stripCaptions = [
  "Erstmal gründlich durchgecheckt …",
  "Kalk? Weg damit!",
  "Frisch geputzt und desinfiziert.",
  "Schleudern unter Volllast – läuft!",
  "Prüfung nach DIN VDE 0701. Bestanden!",
];
---

<Base
  title="kein-krempel – Maskottchen"
  current="maskottchen"
  fonts="family=League+Spartan:wght@500;700;800;900&family=Patrick+Hand&family=Figtree:wght@400;600"
>
  <div class="page">
    <header class="nav">
      <a href="#" class="brand"><Wordmark kein="#e5642a" krempel="#141414" logoBg="#141414" logoFg="#fff" /></a>
      <a class="call" href={b.phoneHref}>☎ {b.phone}</a>
    </header>

    <section class="hero">
      <div class="hero-copy">
        <h1>Wir sind nicht alt.<br /><span>Wir sind erfahren.</span></h1>
        <p>
          Generalüberholte Waschmaschinen, Trockner, Herde, Geschirrspüler und Kühlgeräte aus Chemnitz – mit bis zu {
            b.warrantyMonths
          } Monaten Garantie.
        </p>
        <a class="btn" href="#besuch">Besuch uns im Laden</a>
      </div>
      <div class="stage" aria-hidden="true">
        <div class="burst"></div>
        <div class="duo">
          <div class="char">
            <p class="bubble left">Generalüberholt!</p>
            <Mascot kind="stove" />
          </div>
          <div class="char">
            <p class="bubble right">{b.warrantyMonths} Monate Garantie!</p>
            <Mascot kind="washer" />
          </div>
        </div>
      </div>
    </section>

    <section class="strip">
      <h2>Wie aus einem Gebrauchten ein <mark>kein-krempel</mark>-Gerät wird</h2>
      <ol>
        {
          b.refurbishSteps.map((s, i) => (
            <li>
              <span class="no">{i + 1}</span>
              <p class="say">{stripCaptions[i]}</p>
              <p class="fact">{s}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="family">
      <h2>Die ganze Familie</h2>
      <ul>
        {
          b.categories.map((c) => (
            <li>
              <span>{c.short}</span>
              <strong>{c.name}</strong>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="services">
      <article>
        <h3>Krank? Wir helfen.</h3>
        <p class="lead">Reparatur & Diagnose</p>
        <p>{b.repair.intro}</p>
        {
          b.repair.options.map((o) => (
            <div class="price">
              <span>{o.name}</span>
              <b>{o.price}</b>
            </div>
          ))
        }
        <p class="fine">{b.repair.parts}</p>
      </article>
      <article class="orange">
        <h3>Wir kommen zu dir.</h3>
        <p class="lead">Lieferung in Chemnitz</p>
        <p>{b.delivery.intro}</p>
        {
          b.delivery.options.map((o) => (
            <div class="price">
              <span>
                {o.name} · {o.detail}
              </span>
              <b>{o.price}</b>
            </div>
          ))
        }
        <p class="fine">{b.delivery.note}</p>
      </article>
      <article>
        <h3>Neue Kollegen gesucht!</h3>
        <p class="lead">Abholung & Ankauf</p>
        <p>{b.pickup.intro}</p>
        <ul>{b.pickup.checklist.map((c) => <li>{c}</li>)}</ul>
      </article>
    </section>

    <section class="visit" id="besuch">
      <figure>
        <img
          src={photo}
          alt="Ladenfront von kein-krempel mit den Maskottchen an der Wand"
          width="600"
          height="339"
          loading="lazy"
        />
        <figcaption class="bubble">Hier wohnen wir!</figcaption>
      </figure>
      <div>
        <h2>Komm vorbei</h2>
        <p class="addr">
          {b.address.street}<br />{b.address.zip}
          {b.address.city}-{b.address.district}
        </p>
        <p>{b.address.note}</p>
        <ul class="hours">
          {
            b.hours.map((h) => (
              <li>
                <b>{h.days}</b> {h.time}
              </li>
            ))
          }
        </ul>
        <div class="actions">
          <a class="btn" href={b.phoneHref}>{b.phone}</a>
          <a class="btn alt" href={b.mapsHref} target="_blank" rel="noopener noreferrer">Route ↗</a>
        </div>
      </div>
    </section>

    <footer>
      <span>{b.legalName}</span>
      <span><a href="#">Impressum</a> · <a href="#">Datenschutz</a></span>
    </footer>
  </div>
</Base>

<style>
  .page {
    --orange: #e5642a;
    --ink: #141414;
    --gray: #8e9194;
    --light: #f1f1ef;
    --head: "League Spartan", sans-serif;
    --hand: "Patrick Hand", cursive;
    background: #fff;
    color: var(--ink);
    font-family: "Figtree", sans-serif;
    font-size: 1.05rem;
    line-height: 1.6;
    padding-bottom: 5rem;
    overflow-x: clip;
  }
  a {
    color: inherit;
  }
  h1,
  h2,
  h3 {
    font-family: var(--head);
    line-height: 0.95;
    margin: 0;
  }

  .nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem clamp(1rem, 4vw, 3rem);
    border-bottom: 4px solid var(--ink);
  }
  .brand {
    text-decoration: none;
    font: 800 clamp(1rem, 2.2vw, 1.5rem) var(--head);
  }
  .call {
    font: 700 1rem var(--head);
    text-decoration: none;
    border: 3px solid var(--ink);
    border-radius: 999px;
    padding: 0.5rem 1rem 0.35rem;
  }

  .hero {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    align-items: center;
    gap: 2rem;
    padding: clamp(2rem, 5vw, 4rem) clamp(1rem, 4vw, 3rem);
  }
  h1 {
    font-size: clamp(2.8rem, 6.5vw, 5.8rem);
    font-weight: 900;
    letter-spacing: -0.02em;
  }
  h1 span {
    color: var(--orange);
  }
  .hero-copy p {
    max-width: 30rem;
    margin: 1.5rem 0 2rem;
    font-size: 1.15rem;
  }
  .btn {
    display: inline-block;
    background: var(--orange);
    color: #fff;
    text-decoration: none;
    font: 800 1.05rem var(--head);
    padding: 1rem 1.6rem 0.8rem;
    border: 3px solid var(--ink);
    border-radius: 999px;
    box-shadow: 0 5px 0 var(--ink);
    transition: 0.15s;
  }
  .btn:hover {
    transform: translateY(3px);
    box-shadow: 0 2px 0 var(--ink);
  }
  .btn.alt {
    background: #fff;
    color: var(--ink);
  }

  .stage {
    position: relative;
    aspect-ratio: 1.15;
    display: grid;
    place-items: end center;
  }
  .burst {
    position: absolute;
    inset: 4%;
    background: var(--orange);
    clip-path: polygon(
      50% 0,
      59% 18%,
      79% 9%,
      77% 30%,
      98% 32%,
      85% 49%,
      100% 64%,
      79% 70%,
      84% 91%,
      63% 84%,
      50% 100%,
      37% 84%,
      16% 91%,
      21% 70%,
      0 64%,
      15% 49%,
      2% 32%,
      23% 30%,
      21% 9%,
      41% 18%
    );
    animation: spin 40s linear infinite;
  }
  .burst::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(circle, rgb(0 0 0 / 0.14) 1.5px, transparent 2px) 0 0 / 10px 10px;
  }
  .duo {
    position: relative;
    display: flex;
    gap: 1rem;
    width: 88%;
    margin-bottom: 4%;
  }
  .char {
    position: relative;
    flex: 1;
  }
  .char:first-child {
    animation: bounce 2s ease-in-out infinite;
  }
  .char:last-child {
    animation: bounce 2s 1s ease-in-out infinite;
  }
  .bubble {
    position: absolute;
    top: -3.2rem;
    z-index: 1;
    margin: 0;
    background: #fff;
    border: 3px solid var(--ink);
    border-radius: 1.25rem;
    padding: 0.4rem 0.9rem;
    font: 1.3rem/1.15 var(--hand);
    white-space: nowrap;
    animation: pop 0.5s cubic-bezier(0.3, 1.6, 0.5, 1) both;
  }
  .bubble::after {
    content: "";
    position: absolute;
    bottom: -14px;
    width: 18px;
    height: 14px;
    background: var(--ink);
    clip-path: polygon(0 0, 100% 0, 30% 100%);
  }
  .bubble.left {
    left: 0;
    animation-delay: 0.6s;
  }
  .bubble.left::after {
    left: 2.5rem;
  }
  .bubble.right {
    right: 0;
    animation-delay: 1.1s;
  }
  .bubble.right::after {
    right: 2.5rem;
    transform: scaleX(-1);
  }

  section:not(.hero) {
    padding: clamp(3rem, 6vw, 5rem) clamp(1rem, 4vw, 3rem);
  }
  h2 {
    font-size: clamp(2rem, 4.5vw, 3.6rem);
    font-weight: 900;
    margin-bottom: 2rem;
    max-width: 22ch;
  }
  mark {
    background: var(--orange);
    color: #fff;
    padding: 0 0.15em;
  }

  .strip {
    background: var(--ink);
    color: #fff;
  }
  .strip ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 0.75rem;
  }
  .strip li {
    position: relative;
    background:
      radial-gradient(circle, rgb(0 0 0 / 0.12) 1.5px, transparent 2px) 0 0 / 9px 9px,
      #fff;
    color: var(--ink);
    border: 4px solid #fff;
    outline: 3px solid var(--ink);
    outline-offset: -7px;
    min-height: 15rem;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .strip li:nth-child(even) {
    background:
      radial-gradient(circle, rgb(0 0 0 / 0.14) 1.5px, transparent 2px) 0 0 / 9px 9px,
      var(--orange);
  }
  .strip .no {
    font: 900 3.5rem/1 var(--head);
  }
  .say {
    background: #fff;
    border: 3px solid var(--ink);
    border-radius: 1rem;
    padding: 0.5rem 0.75rem;
    font: 1.15rem/1.2 var(--hand);
    margin: 0.5rem 0;
  }
  .fact {
    font: 700 0.8rem var(--head);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0;
  }

  .family ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1rem;
  }
  .family li {
    border: 3px solid var(--ink);
    border-radius: 1.25rem;
    padding: 1.25rem;
    background: var(--light);
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    transition: transform 0.2s cubic-bezier(0.3, 1.6, 0.5, 1);
  }
  .family li:hover {
    transform: rotate(-2deg) scale(1.03);
    background: var(--orange);
    color: #fff;
  }
  .family span {
    font: 1.4rem var(--hand);
  }
  .family strong {
    font: 800 1.35rem var(--head);
    hyphens: auto;
  }

  .services {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    align-items: start;
  }
  .services article {
    border: 4px solid var(--ink);
    border-radius: 1.5rem;
    padding: 1.75rem;
    box-shadow: 8px 8px 0 var(--gray);
  }
  .services article.orange {
    background: var(--orange);
    color: #fff;
    box-shadow: 8px 8px 0 var(--ink);
  }
  .services h3 {
    font-size: 2rem;
    font-weight: 900;
  }
  .lead {
    font: 1.3rem var(--hand);
    margin: 0.3rem 0 0.75rem;
  }
  .price {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    border-top: 2px dashed currentColor;
    padding: 0.6rem 0;
  }
  .price b {
    font: 900 1.4rem var(--head);
    white-space: nowrap;
  }
  .fine {
    font-size: 0.85rem;
    opacity: 0.8;
  }
  .services ul {
    padding-left: 1.2rem;
    margin: 0;
  }

  .visit {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .visit figure {
    position: relative;
    margin: 0;
  }
  .visit img {
    width: 100%;
    height: auto;
    border: 4px solid var(--ink);
    border-radius: 1.25rem;
    rotate: -1.5deg;
  }
  .visit figcaption {
    top: -1.5rem;
    right: 1.5rem;
    font-size: 1.6rem;
  }
  .visit figcaption::after {
    left: 2rem;
  }
  .addr {
    font: 800 clamp(1.4rem, 2.5vw, 2rem) / 1.15 var(--head);
    margin: 0 0 0.5rem;
  }
  .hours {
    list-style: none;
    padding: 0;
    margin: 1.25rem 0 2rem;
    font-size: 1.15rem;
  }
  .actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  footer {
    display: flex;
    justify-content: space-between;
    padding: 1.5rem clamp(1rem, 4vw, 3rem);
    border-top: 4px solid var(--ink);
    font-size: 0.9rem;
  }

  @keyframes spin {
    to {
      rotate: 360deg;
    }
  }
  @keyframes bounce {
    50% {
      transform: translateY(-10px);
    }
  }
  @keyframes pop {
    from {
      opacity: 0;
      scale: 0.3;
    }
  }

  @media (max-width: 960px) {
    .hero,
    .services,
    .visit {
      grid-template-columns: 1fr;
    }
    .strip ol,
    .family ul {
      grid-template-columns: repeat(2, 1fr);
    }
    .stage {
      margin-top: 3rem;
    }
    .bubble {
      font-size: 1rem;
    }
  }
</style>
