---
import Base from "../../layouts/Base.astro";
import { business as b } from "../../data/business";
---

<Base
  title="kein-krempel – Werkstatt"
  current="werkstatt"
  fonts="family=Barlow+Condensed:wght@500;700;800&family=IBM+Plex+Mono:wght@400;500;600"
>
  <div class="page">
    <header class="topbar">
      <span class="logo">KEIN—KREMPEL<sup>®</sup></span>
      <span class="meta">
        {b.hours.map((h) => <span>{h.days} {h.time}</span>)}
      </span>
      <a class="call" href={b.phoneHref}>☎ {b.phone}</a>
    </header>

    <section class="hero">
      <div class="hero-text">
        <p class="eyebrow">[ Chemnitz-Bernsdorf / seit Jahren am Schraubenschlüssel ]</p>
        <h1>
          <span>Gebraucht.</span>
          <span>Geprüft.</span>
          <span class="accent">Garantiert.</span>
        </h1>
        <p class="lede">
          Generalüberholte Waschmaschinen, Trockner, Herde, Geschirrspüler und Kühlgeräte – mit bis zu
          <strong>{b.warrantyMonths} Monaten Garantie</strong> auf jedes Großgerät.
        </p>
        <div class="actions">
          <a class="btn primary" href={b.phoneHref}>Jetzt anrufen</a>
          <a class="btn" href="#besuch">Anfahrt →</a>
        </div>
      </div>

      <aside class="protocol" aria-label="Prüfprotokoll">
        <div class="protocol-head">
          <span>PRÜFPROTOKOLL</span>
          <span>Nr. 0701-KK</span>
        </div>
        <ol>
          {
            b.refurbishSteps.map((step, i) => (
              <li style={`--d:${0.4 + i * 0.25}s`}>
                <span class="num">{String(i + 1).padStart(2, "0")}</span>
                <span>{step}</span>
                <span class="ok">OK</span>
              </li>
            ))
          }
        </ol>
        <div class="stamp" aria-hidden="true">
          <span>GEPRÜFT</span>
          <small>DIN VDE 0701</small>
        </div>
      </aside>
    </section>

    <div class="hazard" aria-hidden="true"></div>

    <section class="range">
      <h2 class="section-label"><span>01</span> Sortiment</h2>
      <ul>
        {
          b.categories.map((c, i) => (
            <li>
              <span class="idx">{String(i + 1).padStart(2, "0")}</span>
              <span class="cat">{c.name}</span>
              <span class="tag">generalüberholt · {b.warrantyMonths} Mon. Garantie</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="services">
      <h2 class="section-label"><span>02</span> Service</h2>
      <div class="grid">
        <article>
          <h3>Reparatur</h3>
          <p>{b.repair.intro}</p>
          <table>
            {
              b.repair.options.map((o) => (
                <tr>
                  <th scope="row">{o.name}</th>
                  <td>{o.price}</td>
                </tr>
              ))
            }
          </table>
          <p class="small">{b.repair.parts}</p>
        </article>
        <article>
          <h3>Lieferung</h3>
          <p>{b.delivery.intro}</p>
          <table>
            {
              b.delivery.options.map((o) => (
                <tr>
                  <th scope="row">
                    {o.name}
                    <small>{o.detail}</small>
                  </th>
                  <td>{o.price}</td>
                </tr>
              ))
            }
          </table>
          <p class="small">{b.delivery.note}</p>
        </article>
        <article class="dark">
          <h3>Abholung & Ankauf</h3>
          <p>{b.pickup.intro}</p>
          <p class="small">Halten Sie bereit:</p>
          <ul>{b.pickup.checklist.map((c) => <li>{c}</li>)}</ul>
          <a class="btn primary" href={b.phoneHref}>Termin vereinbaren</a>
        </article>
      </div>
    </section>

    <section class="visit" id="besuch">
      <h2 class="section-label"><span>03</span> Besuch</h2>
      <div class="visit-grid">
        <a class="big-phone" href={b.phoneHref}>{b.phone}</a>
        <dl>
          <dt>Adresse</dt>
          <dd>
            {b.address.street}<br />{b.address.zip}
            {b.address.city} / {b.address.district}<br />
            <em>{b.address.note}</em>
          </dd>
          <dt>Öffnungszeiten</dt>
          <dd>{b.hours.map((h) => <div>{h.days} &nbsp; {h.time}</div>)}</dd>
          <dt>Karte</dt>
          <dd><a href={b.mapsHref} target="_blank" rel="noopener noreferrer">Route planen ↗</a></dd>
        </dl>
      </div>
    </section>

    <footer>
      <span>{b.legalName}</span>
      <span><a href="#">Impressum</a> · <a href="#">Datenschutz</a></span>
    </footer>
  </div>
</Base>

<style>
  .page {
    --ink: #1a1b1d;
    --paper: #efece4;
    --orange: #ff5a1f;
    --line: #1a1b1d;
    --mono: "IBM Plex Mono", ui-monospace, monospace;
    --cond: "Barlow Condensed", sans-serif;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--mono);
    font-size: 0.95rem;
    line-height: 1.55;
    background-image:
      linear-gradient(rgb(0 0 0 / 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgb(0 0 0 / 0.045) 1px, transparent 1px);
    background-size: 24px 24px;
    padding-bottom: 5rem;
  }
  a {
    color: inherit;
  }

  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem clamp(1rem, 4vw, 3rem);
    border-bottom: 2px solid var(--line);
    background: var(--ink);
    color: var(--paper);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .logo {
    font: 800 1.5rem/1 var(--cond);
    letter-spacing: 0.02em;
  }
  .logo sup {
    color: var(--orange);
    font-size: 0.6em;
  }
  .meta {
    display: flex;
    gap: 1.5rem;
    opacity: 0.75;
  }
  .call {
    color: var(--orange);
    text-decoration: none;
    font-weight: 600;
  }

  .hero {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: clamp(2rem, 5vw, 5rem);
    padding: clamp(2.5rem, 7vw, 6rem) clamp(1rem, 4vw, 3rem);
    align-items: center;
  }
  .eyebrow {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 1.5rem;
  }
  h1 {
    font: 800 clamp(3.5rem, 11vw, 9.5rem) / 0.85 var(--cond);
    text-transform: uppercase;
    margin: 0;
    letter-spacing: -0.01em;
  }
  h1 span {
    display: block;
    animation: rise 0.7s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }
  h1 span:nth-child(2) {
    animation-delay: 0.1s;
  }
  h1 span:nth-child(3) {
    animation-delay: 0.2s;
  }
  .accent {
    color: var(--orange);
  }
  .lede {
    max-width: 34rem;
    margin: 2rem 0;
  }
  .actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .btn {
    display: inline-block;
    padding: 0.85rem 1.4rem;
    border: 2px solid var(--ink);
    text-decoration: none;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.8rem;
    transition:
      transform 0.15s,
      box-shadow 0.15s;
    box-shadow: 4px 4px 0 var(--ink);
  }
  .btn:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 var(--ink);
  }
  .btn.primary {
    background: var(--orange);
  }

  .protocol {
    position: relative;
    background: #fff;
    border: 2px solid var(--ink);
    box-shadow: 10px 10px 0 var(--ink);
    padding: 0;
  }
  .protocol-head {
    display: flex;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    background: var(--ink);
    color: var(--paper);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
  }
  .protocol ol {
    list-style: none;
    margin: 0;
    padding: 0.5rem 1rem 1.5rem;
  }
  .protocol li {
    display: grid;
    grid-template-columns: 2.2rem 1fr auto;
    gap: 0.5rem;
    padding: 0.75rem 0;
    border-bottom: 1px dashed #999;
    animation: fade 0.4s both;
    animation-delay: var(--d);
  }
  .num {
    color: #888;
  }
  .ok {
    font-weight: 600;
    color: #fff;
    background: #1f9d55;
    padding: 0 0.4rem;
    font-size: 0.75rem;
    align-self: center;
    animation: pop 0.3s both;
    animation-delay: calc(var(--d) + 0.2s);
  }
  .stamp {
    position: absolute;
    right: -1.5rem;
    bottom: -2.5rem;
    border: 4px solid var(--orange);
    color: var(--orange);
    padding: 0.4rem 1rem;
    font: 800 2.2rem/1 var(--cond);
    text-align: center;
    rotate: -12deg;
    background: rgb(255 255 255 / 0.8);
    animation: stamp 0.35s cubic-bezier(0.3, 1.6, 0.5, 1) 2s both;
  }
  .stamp small {
    display: block;
    font: 600 0.7rem var(--mono);
    letter-spacing: 0.15em;
  }

  .hazard {
    height: 22px;
    background: repeating-linear-gradient(-45deg, var(--ink) 0 14px, var(--orange) 14px 28px);
    border-block: 2px solid var(--ink);
  }

  section:not(.hero) {
    padding: clamp(3rem, 6vw, 5rem) clamp(1rem, 4vw, 3rem);
  }
  .section-label {
    font: 700 0.85rem var(--mono);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin: 0 0 2rem;
    display: flex;
    gap: 1rem;
    align-items: center;
  }
  .section-label span {
    background: var(--ink);
    color: var(--paper);
    padding: 0.15rem 0.5rem;
  }
  .section-label::after {
    content: "";
    flex: 1;
    height: 2px;
    background: var(--ink);
  }

  .range ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 2px solid var(--ink);
  }
  .range li {
    display: grid;
    grid-template-columns: 4rem 1fr auto;
    align-items: baseline;
    gap: 1rem;
    padding: 0.6rem 0.5rem;
    border-bottom: 2px solid var(--ink);
    transition:
      background 0.2s,
      padding 0.2s;
  }
  .range li:hover {
    background: var(--orange);
    padding-left: 1.5rem;
  }
  .idx {
    font-size: 0.8rem;
  }
  .cat {
    font: 700 clamp(2rem, 6vw, 4.5rem) / 1 var(--cond);
    text-transform: uppercase;
  }
  .tag {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .services .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border: 2px solid var(--ink);
    background: #fff;
  }
  .services article {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .services article + article {
    border-left: 2px solid var(--ink);
  }
  .services article.dark {
    background: var(--ink);
    color: var(--paper);
  }
  .services article.dark .btn {
    color: var(--ink);
    box-shadow: 4px 4px 0 var(--orange);
    border-color: var(--orange);
    margin-top: auto;
    align-self: flex-start;
  }
  h3 {
    font: 800 2.4rem/1 var(--cond);
    text-transform: uppercase;
    margin: 0 0 0.5rem;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    margin: 1rem 0;
  }
  th,
  td {
    text-align: left;
    padding: 0.6rem 0;
    border-top: 1px dashed #999;
    font-weight: 500;
    vertical-align: top;
  }
  th small {
    display: block;
    color: #777;
    font-weight: 400;
  }
  td {
    text-align: right;
    font: 800 1.6rem/1 var(--cond);
    color: var(--orange);
  }
  .small {
    font-size: 0.8rem;
    opacity: 0.75;
  }
  .dark ul {
    padding-left: 1.1rem;
    margin: 0 0 1.5rem;
    font-size: 0.85rem;
  }

  .visit-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 3rem;
    align-items: end;
  }
  .big-phone {
    font: 800 clamp(3rem, 10vw, 8rem) / 0.9 var(--cond);
    text-decoration: none;
    color: var(--ink);
    -webkit-text-stroke: 2px var(--ink);
    transition: color 0.2s;
  }
  .big-phone:hover {
    color: var(--orange);
  }
  dl {
    margin: 0;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.75rem 1.5rem;
  }
  dt {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding-top: 0.2rem;
    color: #666;
  }
  dd {
    margin: 0;
  }
  dd em {
    color: var(--orange);
    font-style: normal;
  }

  footer {
    display: flex;
    justify-content: space-between;
    padding: 1.5rem clamp(1rem, 4vw, 3rem);
    border-top: 2px solid var(--ink);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(40%);
    }
  }
  @keyframes fade {
    from {
      opacity: 0;
      transform: translateX(-8px);
    }
  }
  @keyframes pop {
    from {
      opacity: 0;
      transform: scale(0.4);
    }
  }
  @keyframes stamp {
    from {
      opacity: 0;
      transform: scale(2.2);
    }
  }

  @media (max-width: 900px) {
    .hero,
    .visit-grid,
    .services .grid {
      grid-template-columns: 1fr;
    }
    .services article + article {
      border-left: 0;
      border-top: 2px solid var(--ink);
    }
    .meta,
    .tag {
      display: none;
    }
    .range li {
      grid-template-columns: 3rem 1fr;
    }
    .stamp {
      right: 0.5rem;
    }
  }
</style>
