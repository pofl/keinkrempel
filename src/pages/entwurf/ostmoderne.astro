---
import { business as b } from "../../data/business";
import Base from "../../layouts/Base.astro";

const codes = ["WM", "TR", "HD", "GS", "KG"];
---

<Base
  title="kein-krempel – Ostmoderne"
  current="ostmoderne"
  fonts="family=Shrikhand&family=Karla:ital,wght@0,400;0,600;0,800;1,400"
>
  <div class="page">
    <header class="nav">
      <a class="brand" href="#">kein krempel</a>
      <span class="since">Haushaltsgeräte · Chemnitz-Bernsdorf</span>
      <a class="phone" href={b.phoneHref}>Ruf {b.phone}</a>
    </header>

    <section class="hero">
      <div class="hero-copy">
        <p class="pre">Katalog Herbst/Winter</p>
        <h1>Gute Geräte.<br /><span>Zweite Runde.</span></h1>
        <p class="lede">
          Generalüberholte Waschmaschinen, Trockner, Herde, Geschirrspüler und Kühlgeräte – solide wie früher, geprüft wie heute.
        </p>
        <a class="btn" href="#besuch">Zum Laden</a>
      </div>
      <div class="arch" aria-hidden="true">
        <div class="bands"><i></i><i></i><i></i><i></i></div>
        <div class="seal">
          <svg viewBox="0 0 200 200">
            <defs>
              <path id="seal-path" d="M100,100 m-72,0 a72,72 0 1,1 144,0 a72,72 0 1,1 -144,0"></path>
            </defs>
            <text><textPath href="#seal-path">Gütezeichen · geprüft nach DIN VDE 0701 ·</textPath></text>
          </svg>
          <span class="k">K</span>
        </div>
      </div>
    </section>

    <div class="stripes" aria-hidden="true"><i></i><i></i><i></i><i></i></div>

    <section class="catalog">
      <div class="section-head">
        <h2>Das Sortiment</h2>
        <p>Jedes Großgerät mit bis zu <b>{b.warrantyMonths} Monaten</b> Garantie.</p>
      </div>
      <ul>
        {
          b.categories.map((c, i) => (
            <li>
              <span class="code">
                KK-{codes[i]}/{String(i + 1).padStart(2, "0")}
              </span>
              <span class="arch-icon" />
              <h3>{c.name}</h3>
              <span class="verb">zum {c.short}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="quality">
      <div class="q-card">
        <h2>Fünfmal geprüft, <span>einmal gekauft.</span></h2>
        <ol>{b.refurbishSteps.map((s) => <li>{s}</li>)}</ol>
      </div>
      <div class="big-warranty">
        <span class="num">{b.warrantyMonths}</span>
        <span class="txt">Monate<br />Garantie</span>
      </div>
    </section>

    <section class="services">
      <div class="section-head">
        <h2>Dienstleistungen</h2>
      </div>
      <div class="svc-grid">
        <article style="--c: var(--orange)">
          <h3>Reparatur</h3>
          <p>{b.repair.intro}</p>
          <dl>
            {
              b.repair.options.map((o) => (
                <>
                  <dt>{o.name}</dt>
                  <dd>{o.price}</dd>
                </>
              ))
            }
          </dl>
          <p class="small">{b.repair.parts}</p>
        </article>
        <article style="--c: var(--teal)">
          <h3>Lieferung</h3>
          <p>{b.delivery.intro}</p>
          <dl>
            {
              b.delivery.options.map((o) => (
                <>
                  <dt>
                    {o.name} <em>({o.detail})</em>
                  </dt>
                  <dd>{o.price}</dd>
                </>
              ))
            }
          </dl>
          <p class="small">{b.delivery.note}</p>
        </article>
        <article style="--c: var(--mustard)">
          <h3>Abholung & Ankauf</h3>
          <p>{b.pickup.intro}</p>
          <ul>{b.pickup.checklist.map((c) => <li>{c}</li>)}</ul>
        </article>
      </div>
    </section>

    <section class="visit" id="besuch">
      <div class="visit-sun" aria-hidden="true"></div>
      <div class="visit-body">
        <h2>Besuchen Sie uns!</h2>
        <div class="visit-grid">
          <div>
            <h4>Anschrift</h4>
            <p>
              {b.legalName}<br />
              {b.address.street}<br />
              {b.address.zip}
              {b.address.city} / {b.address.district}
            </p>
            <p><em>{b.address.note}</em></p>
          </div>
          <div>
            <h4>Geöffnet</h4>
            {b.hours.map((h) => <p><b>{h.days}</b> {h.time}</p>)}
          </div>
          <div>
            <h4>Fernruf</h4>
            <p><a href={b.phoneHref}>{b.phone}</a></p>
            <p><a href={b.mapsHref} target="_blank" rel="noopener noreferrer">Stadtplan ↗</a></p>
          </div>
        </div>
      </div>
    </section>

    <footer>
      <span>kein krempel · Chemnitz</span>
      <span><a href="#">Impressum</a> · <a href="#">Datenschutz</a></span>
    </footer>
  </div>
</Base>

<style>
  .page {
    --cream: #f4e6c8;
    --paper: #fbf3e1;
    --brown: #3d2417;
    --orange: #d4572a;
    --mustard: #e3a72f;
    --teal: #1f6d68;
    --rose: #e9a28a;
    --display: "Shrikhand", serif;
    --body: "Karla", sans-serif;
    background: var(--cream);
    color: var(--brown);
    font-family: var(--body);
    font-size: 1.05rem;
    line-height: 1.6;
    overflow-x: clip;
    padding-bottom: 5rem;
  }
  a {
    color: inherit;
  }
  h1,
  h2,
  h3 {
    font-family: var(--display);
    font-weight: 400;
    margin: 0;
  }

  .nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem clamp(1rem, 4vw, 3rem);
    border-bottom: 3px solid var(--brown);
  }
  .brand {
    font: 1.8rem var(--display);
    text-decoration: none;
    color: var(--orange);
  }
  .since {
    font-size: 0.85rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-weight: 600;
  }
  .phone {
    font-weight: 800;
    text-decoration: none;
    background: var(--brown);
    color: var(--cream);
    padding: 0.5rem 1.1rem;
    border-radius: 999px;
  }

  .hero {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    align-items: center;
    gap: 2rem;
    padding: clamp(2.5rem, 6vw, 5rem) clamp(1rem, 4vw, 3rem) 0;
  }
  .pre {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.25em;
    font-weight: 800;
    color: var(--teal);
    margin: 0 0 1rem;
  }
  h1 {
    font-size: clamp(3rem, 8vw, 7rem);
    line-height: 0.95;
    color: var(--brown);
    text-shadow: 4px 4px 0 var(--mustard);
    animation: drop 0.9s cubic-bezier(0.2, 1.3, 0.4, 1) both;
  }
  h1 span {
    color: var(--orange);
  }
  .lede {
    max-width: 30rem;
    font-size: 1.15rem;
    margin: 1.75rem 0 2rem;
  }
  .btn {
    display: inline-block;
    background: var(--orange);
    color: var(--paper);
    text-decoration: none;
    font-weight: 800;
    padding: 0.9rem 2rem;
    border-radius: 999px;
    border: 3px solid var(--brown);
    box-shadow: 0 5px 0 var(--brown);
    transition: 0.15s;
  }
  .btn:hover {
    transform: translateY(3px);
    box-shadow: 0 2px 0 var(--brown);
  }

  .arch {
    position: relative;
    aspect-ratio: 1 / 1.05;
    max-width: 520px;
    width: 100%;
    justify-self: center;
    align-self: end;
  }
  .bands {
    position: absolute;
    inset: 0;
    border-radius: 999px 999px 0 0;
    overflow: hidden;
  }
  .bands i {
    position: absolute;
    left: calc(var(--n) * 12%);
    right: calc(var(--n) * 12%);
    top: calc(var(--n) * 12%);
    bottom: 0;
    border-radius: 999px 999px 0 0;
    animation: rise 1s calc(var(--n) * 0.12s) cubic-bezier(0.2, 0.9, 0.3, 1) both;
  }
  .bands i:nth-child(1) {
    --n: 0;
    background: var(--teal);
  }
  .bands i:nth-child(2) {
    --n: 1;
    background: var(--mustard);
  }
  .bands i:nth-child(3) {
    --n: 2;
    background: var(--orange);
  }
  .bands i:nth-child(4) {
    --n: 3;
    background: var(--brown);
  }
  .seal {
    position: absolute;
    left: 50%;
    bottom: 12%;
    width: 46%;
    aspect-ratio: 1;
    translate: -50% 0;
    background: var(--paper);
    border-radius: 50%;
    border: 4px solid var(--brown);
    display: grid;
    place-items: center;
    animation: pop 0.6s 0.7s cubic-bezier(0.3, 1.6, 0.5, 1) both;
  }
  .seal svg {
    position: absolute;
    inset: 0;
    width: 100%;
    animation: spin 30s linear infinite;
  }
  .seal text {
    font: 800 14px var(--body);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    fill: var(--brown);
  }
  .k {
    font: clamp(3rem, 7vw, 5rem) / 1 var(--display);
    color: var(--orange);
    margin-top: 0.15em;
  }

  .stripes {
    display: grid;
  }
  .stripes i {
    height: 14px;
  }
  .stripes i:nth-child(1) {
    background: var(--teal);
  }
  .stripes i:nth-child(2) {
    background: var(--mustard);
  }
  .stripes i:nth-child(3) {
    background: var(--orange);
  }
  .stripes i:nth-child(4) {
    background: var(--brown);
  }

  section:not(.hero) {
    padding: clamp(3rem, 7vw, 6rem) clamp(1rem, 4vw, 3rem);
  }
  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }
  h2 {
    font-size: clamp(2.2rem, 5vw, 4rem);
    line-height: 1;
  }
  .section-head p {
    margin: 0;
    font-size: 1.1rem;
  }

  .catalog ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1.25rem;
  }
  .catalog li {
    background: var(--paper);
    border: 3px solid var(--brown);
    border-radius: 1.5rem;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    transition: transform 0.25s cubic-bezier(0.3, 1.6, 0.5, 1);
  }
  .catalog li:hover {
    transform: translateY(-8px) rotate(-1.5deg);
  }
  .catalog li:nth-child(1) {
    --c: var(--teal);
  }
  .catalog li:nth-child(2) {
    --c: var(--mustard);
  }
  .catalog li:nth-child(3) {
    --c: var(--orange);
  }
  .catalog li:nth-child(4) {
    --c: var(--rose);
  }
  .catalog li:nth-child(5) {
    --c: var(--teal);
  }
  .code {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.15em;
  }
  .arch-icon {
    display: block;
    aspect-ratio: 1;
    border-radius: 999px 999px 0.75rem 0.75rem;
    background:
      radial-gradient(circle at 50% 62%, var(--paper) 0 22%, var(--brown) 22% 26%, transparent 26%),
      var(--c);
    border: 3px solid var(--brown);
    margin: 0.5rem 0;
  }
  .catalog h3 {
    font-size: clamp(1.1rem, 1.6vw, 1.45rem);
    line-height: 1.1;
    hyphens: auto;
  }
  .verb {
    font-style: italic;
    font-size: 0.9rem;
  }

  .quality {
    background: var(--teal);
    color: var(--paper);
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 3rem;
    align-items: center;
  }
  .quality h2 span {
    color: var(--mustard);
  }
  .q-card ol {
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
    counter-reset: q;
    display: grid;
    gap: 0.6rem;
  }
  .q-card li {
    counter-increment: q;
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 1.15rem;
    font-weight: 600;
  }
  .q-card li::before {
    content: counter(q);
    flex: none;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    background: var(--mustard);
    color: var(--brown);
    display: grid;
    place-items: center;
    font: 1.1rem var(--display);
  }
  .big-warranty {
    justify-self: center;
    width: min(100%, 340px);
    aspect-ratio: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
    isolation: isolate;
  }
  .big-warranty::before,
  .big-warranty::after {
    content: "";
    position: absolute;
    border-radius: 50%;
    z-index: -1;
  }
  .big-warranty::before {
    inset: 0;
    background: repeating-conic-gradient(var(--mustard) 0 10deg, var(--orange) 10deg 20deg);
    animation: spin 60s linear infinite;
  }
  .big-warranty::after {
    inset: 14%;
    background: var(--paper);
    border: 4px solid var(--brown);
  }
  .big-warranty .num {
    font: clamp(4rem, 9vw, 7rem) / 1 var(--display);
    color: var(--orange);
  }
  .big-warranty .txt {
    color: var(--brown);
    text-align: center;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-size: 0.8rem;
    line-height: 1.2;
  }

  .svc-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  .svc-grid article {
    background: var(--paper);
    border: 3px solid var(--brown);
    border-radius: 1.5rem;
    overflow: hidden;
    padding: 0 1.5rem 1.5rem;
  }
  .svc-grid h3 {
    background: var(--c);
    color: var(--paper);
    margin: 0 -1.5rem 1rem;
    padding: 1.25rem 1.5rem 1rem;
    font-size: 1.7rem;
    border-bottom: 3px solid var(--brown);
    text-shadow: 2px 2px 0 var(--brown);
  }
  dl {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.6rem 1rem;
    margin: 1.25rem 0;
    padding: 1rem;
    background: var(--cream);
    border-radius: 1rem;
  }
  dt em {
    opacity: 0.7;
  }
  dd {
    margin: 0;
    font: 1.3rem var(--display);
    color: var(--orange);
  }
  .small {
    font-size: 0.85rem;
    opacity: 0.8;
  }
  .svc-grid ul {
    padding-left: 1.2rem;
    margin: 0;
  }

  .visit {
    position: relative;
    background: var(--brown);
    color: var(--cream);
    overflow: hidden;
  }
  .visit-sun {
    position: absolute;
    right: -10%;
    top: -40%;
    width: 60%;
    aspect-ratio: 1;
    border-radius: 50%;
    background:
      radial-gradient(circle, var(--orange) 0 40%, transparent 40%),
      repeating-radial-gradient(circle, var(--mustard) 0 4%, transparent 4% 8%);
    opacity: 0.55;
  }
  .visit-body {
    position: relative;
  }
  .visit h2 {
    color: var(--mustard);
    font-size: clamp(2.6rem, 7vw, 5.5rem);
    margin-bottom: 2.5rem;
  }
  .visit-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }
  .visit h4 {
    margin: 0 0 0.5rem;
    font-size: 0.8rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--rose);
  }
  .visit p {
    margin: 0 0 0.4rem;
  }

  footer {
    display: flex;
    justify-content: space-between;
    padding: 1.25rem clamp(1rem, 4vw, 3rem);
    font-size: 0.9rem;
  }

  @keyframes drop {
    from {
      opacity: 0;
      transform: translateY(-30px) rotate(-3deg);
    }
  }
  @keyframes rise {
    from {
      transform: translateY(100%);
    }
  }
  @keyframes pop {
    from {
      opacity: 0;
      scale: 0.3;
    }
  }
  @keyframes spin {
    to {
      rotate: 360deg;
    }
  }

  @media (max-width: 960px) {
    .since {
      display: none;
    }
    .hero,
    .quality,
    .svc-grid,
    .visit-grid {
      grid-template-columns: 1fr;
    }
    .catalog ul {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
