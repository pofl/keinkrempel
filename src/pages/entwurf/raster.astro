---
import { business as b } from "../../data/business";
import Base from "../../layouts/Base.astro";
---

<Base
  title="kein-krempel – Raster"
  current="raster"
  fonts="family=Archivo:wdth,wght@62..125,300..900"
>
  <div class="page">
    <div class="cols" aria-hidden="true">
      {Array.from({ length: 12 }, (_, i) => <span style={`--i:${i}`} />)}
    </div>

    <header class="head g">
      <a class="brand" href="#">kein-krempel</a>
      <p class="desc">Generalüberholte<br />Haushaltsgeräte</p>
      <p class="desc">{b.address.street}<br />{b.address.zip} {b.address.city}</p>
      <a class="phone" href={b.phoneHref}>{b.phone}</a>
    </header>

    <section class="hero g">
      <p class="figure" aria-hidden="true">{b.warrantyMonths}</p>
      <div class="hero-text">
        <h1>Monate Garantie auf jedes Großgerät.</h1>
        <p>
          Waschmaschinen, Trockner, Herde, Geschirrspüler und Kühlgeräte. Technisch überholt, entkalkt, desinfiziert, unter Last
          getestet und nach DIN VDE 0701 geprüft.
        </p>
      </div>
    </section>

    <section class="row g">
      <h2 class="label"><span>A</span>Sortiment</h2>
      <ol class="cats">
        {b.categories.map((c) => <li>{c.name}</li>)}
      </ol>
    </section>

    <section class="row g">
      <h2 class="label"><span>B</span>Prüfung</h2>
      <ol class="steps">
        {
          b.refurbishSteps.map((s, i) => (
            <li>
              <span>{String(i + 1).padStart(2, "0")}</span>
              {s}
            </li>
          ))
        }
      </ol>
    </section>

    <section class="row g">
      <h2 class="label"><span>C</span>Reparatur</h2>
      <div class="content">
        <p class="intro">{b.repair.intro}</p>
        <div class="prices">
          {
            b.repair.options.map((o) => (
              <div>
                <p class="price">{o.price}</p>
                <p class="pname">{o.name}</p>
                <p class="ptext">{o.text}</p>
              </div>
            ))
          }
        </div>
        <p class="aside">{b.repair.parts}</p>
      </div>
    </section>

    <section class="row g">
      <h2 class="label"><span>D</span>Lieferung</h2>
      <div class="content">
        <p class="intro">{b.delivery.intro}</p>
        <div class="prices three">
          {
            b.delivery.options.map((o) => (
              <div>
                <p class="price">{o.price}</p>
                <p class="pname">{o.name}</p>
                <p class="ptext">{o.detail}</p>
              </div>
            ))
          }
        </div>
        <p class="aside">{b.delivery.note}</p>
      </div>
    </section>

    <section class="row g">
      <h2 class="label"><span>E</span>Ankauf</h2>
      <div class="content">
        <p class="intro">{b.pickup.intro}</p>
        <ul class="list">{b.pickup.checklist.map((c) => <li>{c}</li>)}</ul>
      </div>
    </section>

    <section class="visit g" id="besuch">
      <h2 class="label inverse"><span>F</span>Öffnungszeiten</h2>
      <div class="hours">
        {
          b.hours.map((h) => (
            <div>
              <p class="day">{h.days}</p>
              <p class="time">{h.time.replace(" Uhr", "")}</p>
            </div>
          ))
        }
      </div>
      <div class="visit-meta">
        <p>
          {b.legalName}<br />
          {b.address.street}<br />
          {b.address.zip}
          {b.address.city}-{b.address.district}<br />
          {b.address.note}
        </p>
        <p>
          <a href={b.phoneHref}>T {b.phone}</a><br />
          <a href={b.mapsHref} target="_blank" rel="noopener noreferrer">Karte ↗</a>
        </p>
      </div>
    </section>

    <footer class="g">
      <span>© kein-krempel</span>
      <span><a href="#">Impressum</a> &nbsp; <a href="#">Datenschutz</a></span>
    </footer>
  </div>
</Base>

<style>
  .page {
    --white: #f7f6f2;
    --black: #0b0b0b;
    --red: #e3120b;
    --pad: clamp(1rem, 3vw, 2.5rem);
    --gap: clamp(0.75rem, 1.5vw, 1.25rem);
    position: relative;
    background: var(--white);
    color: var(--black);
    font-family: "Archivo", sans-serif;
    font-variation-settings: "wdth" 100;
    font-size: 1rem;
    line-height: 1.45;
    font-feature-settings: "tnum";
    padding-bottom: 5rem;
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  a:hover {
    color: var(--red);
  }
  p {
    margin: 0;
  }

  .cols {
    position: absolute;
    inset: 0 var(--pad);
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: var(--gap);
    pointer-events: none;
  }
  .cols span {
    border-inline: 1px solid rgb(227 18 11 / 0.08);
    transform-origin: top;
    animation: grow 1.2s calc(var(--i) * 40ms) cubic-bezier(0.6, 0, 0.2, 1) both;
  }

  .g {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: var(--gap);
    padding-inline: var(--pad);
  }

  .head {
    padding-block: 1.25rem;
    align-items: start;
    font-size: 0.85rem;
    border-bottom: 1px solid var(--black);
  }
  .brand {
    grid-column: 1 / 4;
    font-weight: 800;
    font-size: 1.1rem;
    letter-spacing: -0.02em;
  }
  .desc:nth-of-type(1) {
    grid-column: 4 / 7;
  }
  .desc:nth-of-type(2) {
    grid-column: 7 / 10;
  }
  .phone {
    grid-column: 10 / 13;
    text-align: right;
    font-weight: 700;
  }

  .hero {
    padding-block: clamp(2rem, 5vw, 4rem) clamp(3rem, 6vw, 5rem);
    align-items: end;
    border-bottom: 1px solid var(--black);
  }
  .figure {
    grid-column: 1 / 8;
    font-size: clamp(12rem, 42vw, 40rem);
    font-weight: 900;
    font-variation-settings: "wdth" 62;
    line-height: 0.74;
    letter-spacing: -0.06em;
    color: var(--red);
    margin-left: -0.04em;
    animation: up 1s 0.3s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }
  .hero-text {
    grid-column: 8 / 13;
    animation: up 1s 0.5s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }
  h1 {
    font-size: clamp(2rem, 4vw, 3.6rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.035em;
    margin: 0 0 1.5rem;
  }
  .hero-text p {
    max-width: 28rem;
  }

  .row {
    padding-block: clamp(1.5rem, 3vw, 2.5rem);
    border-bottom: 1px solid var(--black);
  }
  .label {
    grid-column: 1 / 4;
    font-size: 0.85rem;
    font-weight: 600;
    margin: 0;
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
  }
  .label span {
    color: var(--red);
  }
  .content {
    grid-column: 4 / 13;
  }

  .cats {
    grid-column: 4 / 13;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .cats li {
    font-size: clamp(2.2rem, 6vw, 5.5rem);
    font-weight: 800;
    font-variation-settings: "wdth" 75;
    line-height: 0.95;
    letter-spacing: -0.04em;
    transition:
      color 0.15s,
      padding 0.3s;
  }
  .cats li:hover {
    color: var(--red);
    padding-left: 0.4em;
  }

  .steps {
    grid-column: 4 / 13;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--gap);
  }
  .steps li {
    border-top: 3px solid var(--black);
    padding-top: 0.6rem;
    font-weight: 500;
  }
  .steps span {
    display: block;
    color: var(--red);
    font-size: 0.8rem;
    margin-bottom: 1.5rem;
  }

  .intro {
    font-size: clamp(1.2rem, 2vw, 1.6rem);
    line-height: 1.25;
    letter-spacing: -0.015em;
    max-width: 40rem;
    margin-bottom: 2rem;
  }
  .prices {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--gap);
  }
  .prices.three {
    grid-template-columns: repeat(3, 1fr);
  }
  .price {
    font-size: clamp(3rem, 7vw, 6.5rem);
    font-weight: 800;
    font-variation-settings: "wdth" 70;
    line-height: 0.9;
    letter-spacing: -0.045em;
    margin-bottom: 0.75rem;
  }
  .pname {
    font-weight: 700;
  }
  .ptext {
    font-size: 0.875rem;
    color: #555;
    max-width: 22rem;
  }
  .aside {
    margin-top: 2rem;
    font-size: 0.85rem;
    color: #555;
    max-width: 36rem;
  }
  .list {
    margin: 0;
    padding: 0;
    list-style: none;
    columns: 2;
    column-gap: var(--gap);
  }
  .list li {
    border-top: 1px solid var(--black);
    padding: 0.5rem 0 1rem;
    break-inside: avoid;
  }

  .visit {
    background: var(--red);
    color: var(--white);
    padding-block: clamp(2rem, 5vw, 4rem);
    margin-top: clamp(3rem, 6vw, 5rem);
  }
  .label.inverse span {
    color: var(--black);
  }
  .hours {
    grid-column: 4 / 13;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--gap);
  }
  .day {
    font-weight: 700;
    border-top: 3px solid var(--white);
    padding-top: 0.5rem;
  }
  .time {
    font-size: clamp(3.5rem, 10vw, 9rem);
    font-weight: 900;
    font-variation-settings: "wdth" 62;
    line-height: 0.9;
    letter-spacing: -0.05em;
  }
  .visit-meta {
    grid-column: 4 / 13;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--gap);
    margin-top: 3rem;
    font-size: 0.95rem;
  }
  .visit a:hover {
    color: var(--black);
  }

  footer {
    padding-block: 1.25rem;
    font-size: 0.8rem;
  }
  footer span:first-child {
    grid-column: 1 / 7;
  }
  footer span:last-child {
    grid-column: 7 / 13;
    text-align: right;
  }

  @keyframes grow {
    from {
      transform: scaleY(0);
    }
  }
  @keyframes up {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
  }

  @media (max-width: 860px) {
    .head > *,
    .figure,
    .hero-text,
    .label,
    .content,
    .cats,
    .steps,
    .hours,
    .visit-meta {
      grid-column: 1 / -1;
    }
    .desc {
      display: none;
    }
    .phone {
      text-align: left;
    }
    .steps,
    .prices,
    .prices.three {
      grid-template-columns: 1fr 1fr;
    }
    .list {
      columns: 1;
    }
    .label {
      margin-bottom: 1rem;
    }
  }
</style>
